# Environment variables for Browser Controller

# Browser Configuration
BROWSER_TYPE=chrome
BROWSER_HEADLESS=true
BROWSER_WIDTH=1920
BROWSER_HEIGHT=1080

# Timeouts
BROWSER_IMPLICIT_WAIT=10.0
BROWSER_PAGE_LOAD_TIMEOUT=30.0
BROWSER_SCRIPT_TIMEOUT=30.0

# Proxy Settings (uncomment to enable)
# BROWSER_PROXY_SERVER=proxy.company.com
# BROWSER_PROXY_PORT=8080
# BROWSER_PROXY_USERNAME=username
# BROWSER_PROXY_PASSWORD=password

# User Agent
BROWSER_USER_AGENT=LAM-Browser-Controller/1.0

# Downloads
BROWSER_DOWNLOAD_DIR=./downloads

# Logging
LOG_LEVEL=INFO

# Performance Settings
DISABLE_IMAGES=false
DISABLE_JAVASCRIPT=false
DISABLE_CSS=false

# Security Settings
IGNORE_CERTIFICATE_ERRORS=false
DISABLE_WEB_SECURITY=false
